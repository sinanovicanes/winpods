{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "winpods",
  "version": "0.2.0",
  "identifier": "com.winpods.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "winpods",
        "url": "/",
        "width": 860,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false
      },
      {
        "label": "widget",
        "title": "winpods widget",
        "url": "/widget/",
        "width": 300,
        "height": 125,
        "fullscreen": false,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5ODBFMDUxRkUyNkVBNjAKUldSZzZpYitVZUNBYVJLNWQ4TnJXMXFkcDFYV2dBZndhS2tSVWtoWmI2ZzVVUWppeWpYeUxreEsK",
      "endpoints": ["https://releases.winpods.app/{{current_version}}"]
    }
  }
}
